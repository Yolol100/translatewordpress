# WordPress plugin project ignores
# Keep runtime plugin files, build output, languages, readme, and licenses tracked.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment and local config
.env
.env.*
!.env.example
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PHP tooling / dependencies
vendor/
composer.lock
.phpunit.result.cache
.phpcs-cache
.php-cs-fixer.cache
coverage/
.phpunit.cache/

# Node tooling / dependencies
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Build caches and temporary output
.cache/
.parcel-cache/
.turbo/
.eslintcache
.tmp/
tmp/
temp/
build-cache/

# Test / CI artifacts
junit.xml
clover.xml
coverage.xml
test-results/
playwright-report/

# WordPress local installs and generated packages
wp-config.php
wp-content/uploads/
wp-content/cache/
*.sql
*.sqlite
*.sqlite3
*.zip
*.tar
*.tar.gz
*.tgz

# Release/package working folders
release/
dist/
packages/
*.release/

# Source maps: do not ship unless intentionally needed for debugging
*.map

# Keep important runtime/public files tracked even if patterns above change later
!readme.txt
!license.txt
!LICENSE
!languages/
!languages/**
!build/
!build/**
!assets/
!assets/**
